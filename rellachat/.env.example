# Rellachat voice service (copy to rellachat/.env)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
RELLACHAT_API_URL=http://localhost:8000/api
VOICE_SERVICE_SECRET=
PORT=7860
HOST=0.0.0.0
# Optional JSON list of ICE servers (STUN/TURN). Default: Google public STUN.
# ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
ICE_SERVERS=
