# Rellachat voice service (copy to rellachat/.env)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_STT_MODEL=ink-2
RELLACHAT_API_URL=http://localhost:8000/api
VOICE_SERVICE_SECRET=
PORT=7860
HOST=0.0.0.0
# Optional JSON list of ICE servers (STUN/TURN). Default: Google public STUN.
# Single-quote the JSON so both python-dotenv and docker compose `env_file` read it literally.
# ICE_SERVERS='[{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]'
ICE_SERVERS=
# Phone calls (Telnyx): the API key lets the agent hang up, and PUBLIC_WS_BASE_URL is the public
# wss:// base of this service (Telnyx connects to {base}/phone/ws). Unset disables phone calls.
TELNYX_API_KEY=
PUBLIC_WS_BASE_URL=
